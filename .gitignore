# 개인 설정·비밀정보 (커밋 금지)
.claude/settings.local.json
.env

# AI 커밋 메시지 파일 (고정 경로 — 노하우_승인_대기_최소화.md 참조)
.commit_msg.txt

# 승인 창 기록 (.claude/hooks/log_permission_request.py — 측정기가 읽는다. 사용자 데이터)
.claude/permission_requests.jsonl

# 서브에이전트(researcher·qa-tester)의 일회성 스크립트·임시 산출물 — .claude/agents/*.md
scripts/_tmp/

# 동봉 파이썬 도구(측정기·훅)의 부산물
__pycache__/
.pytest_cache/

# Flutter·Android 빌드 산출물 (앱 폴더 안의 세부 항목은 flutter create가 만드는 .gitignore가 맡는다)
build/
.dart_tool/
*.apk
*.aab

# 서명·기기별 설정 (커밋 금지)
*.jks
*.keystore
key.properties
local.properties
